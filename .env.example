# You normally don't need to fill this in by hand. The setup wizard asks for
# these values and creates the .env file for you.
#
# For a manual install, copy this file to .env and enter your own values.
# Take them from cPanel > Email Accounts > Connect Devices, under
# "Secure SSL/TLS Settings".

# Required
IMAP_HOST=mail.yourdomain.com
IMAP_PORT=993
IMAP_TLS=true
SMTP_HOST=mail.yourdomain.com
SMTP_PORT=465
SMTP_TLS=true
MAIL_USER=user@yourdomain.com
MAIL_PASS=your-mailbox-password

# Optional
MAIL_FROM=user@yourdomain.com

# Calendar (delete this line if you don't want it; calendar tools turn off automatically)
CALDAV_URL=https://mail.yourdomain.com:2080/calendars/user@yourdomain.com/calendar
# If CALDAV_USER / CALDAV_PASS are not set, MAIL_USER / MAIL_PASS are used
# If cPanel's :2080 certificate isn't issued for the server name and you get errors:
# CALDAV_INSECURE_TLS=true

# To enable the delete tool (off by default, irreversible):
# ALLOW_DELETE=true
