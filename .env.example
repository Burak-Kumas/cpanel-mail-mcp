# Bu dosyayı elle doldurmana normalde gerek yok. Kurulum sihirbazı
# bu değerleri sorar ve .env dosyasını senin için oluşturur.
#
# Elle kuracaksan bu dosyayı .env olarak kopyala ve kendi değerlerini gir.
# Değerleri cPanel > Email Accounts > Connect Devices ekranındaki
# "Secure SSL/TLS Settings" bölümünden al.

# Zorunlu
IMAP_HOST=mail.alanadiniz.com
IMAP_PORT=993
IMAP_TLS=true
SMTP_HOST=mail.alanadiniz.com
SMTP_PORT=465
SMTP_TLS=true
MAIL_USER=kullanici@alanadiniz.com
MAIL_PASS=posta-hesabi-sifreniz

# İsteğe bağlı
MAIL_FROM=kullanici@alanadiniz.com

# Takvim (istemiyorsan bu satırı sil — takvim araçları otomatik kapanır)
CALDAV_URL=https://mail.alanadiniz.com:2080/calendars/kullanici@alanadiniz.com/calendar
# CALDAV_USER / CALDAV_PASS verilmezse MAIL_USER / MAIL_PASS kullanılır
# cPanel :2080 sertifikası sunucu adına kesilmemişse ve hata alırsan:
# CALDAV_INSECURE_TLS=true

# Silme aracını açmak istersen (varsayılan kapalı, geri alınamaz işlem):
# ALLOW_DELETE=true
